generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  books Book[]
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  description String?
  publishYear String?
  tags        String?
  coverUrl    String?
  pdfUrl      String
  
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  
  createdAt   DateTime @default(now())
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  title       String
  role        String
  description String?
  photoUrl    String?
  orderIndex  Int      @default(0)
}
